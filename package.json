{
  "name": "momo-pose-forge",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "check:setup": "node tools/check-workbench.mjs",
    "test:setup": "node --test tools/check-workbench.test.mjs",
    "predev": "npm run check:setup",
    "dev": "vite --host 127.0.0.1 --port 5173",
    "prebuild": "npm run check:setup",
    "build": "tsc --noEmit && vite build && node tools/build-docs.mjs && node tools/check-built-site.mjs",
    "build:pages": "npm run check:setup && tsc --noEmit && vite build --base=/MomoPoseForge/ && node tools/build-docs.mjs && node tools/check-built-site.mjs",
    "check:docs": "node tools/check-docs.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@momo/workbench": "file:vendor/momo-workbench-0.2.0.tgz",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "~0.180.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/three": "~0.180.0",
    "@vitejs/plugin-react": "^5.0.3",
    "fake-indexeddb": "6.2.7",
    "marked": "18.1.3",
    "pngjs": "^7.0.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vitest": "^5.0.5"
  }
}
